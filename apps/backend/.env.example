# Copy to apps/backend/.env — loaded automatically by src/index.ts on startup.
# These keys are read on the server only and are never sent to the client (CLAUDE.md).

# OpenAI Images API — POST /api/generate-image
OPENAI_API_KEY=

# Meshy AI (image-to-3D) — POST /api/generate-3d
MESHY_API_KEY=

# HTTP + WebSocket port (default 3001)
PORT=3001
